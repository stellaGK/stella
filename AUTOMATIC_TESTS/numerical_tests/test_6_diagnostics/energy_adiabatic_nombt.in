! Adiabatic electrons, NO modified Boltzmann response (periodic Boltzmann response).
! Same small linear Miller run as energy_closure.in, but nspec=1 (ion only)
! and adiabatic_option = 'no-field-line-average-term'. Exercised for the
! free-energy closure so the field-energy path is tested for a second
! electron model.

&geometry_options
  geometry_option = 'miller'
/
&geometry_miller
  betadbprim = 0.0
  betaprim = 0.058
  d2psidr2 = 0.0
  d2qdr2 = 0.0
  kappa = 1.5504
  kapprim = 0.94963
  nzed_local = 128
  qinp = 5.0848
  rgeo = 3.1191
  rhoc = 0.97427
  rmaj = 3.134
  shat = 3.3594
  shift = -0.34508
  tri = 0.26253
  triprim = 0.7368
/

&gyrokinetic_terms
  include_nonlinear = .false.
/

&species_options
  nspec = 1
/
&species_parameters_1
  dens = 1.0
  fprim = 1.0
  mass = 1.0
  temp = 1.0
  tprim = 3.0
  type = 'ion'
  z = 1.0
/

&adiabatic_electron_response
  adiabatic_option = 'no-field-line-average-term'
  tite = 1.0
  nine = 1.0
/

&kxky_grid_option
  grid_option = 'range'
/
&kxky_grid_range
  akx_max = 0.0
  akx_min = 0.0
  aky_max = 1.5
  aky_min = 1.5
  nakx = 1
  naky = 1
/
&z_grid
  nzed = 24
/
&z_boundary_condition
  boundary_option = 'linked'
/
&velocity_grids
  nmu = 2
  nvgrid = 3
/

&diagnostics
  nsave = 10
  nwrite = 1
/

&diagnostics_energy
  write_energy = .true.
  write_energy_kxkyz = .true.
  write_energy_vmu = .true.
/

&initialise_distribution
  initialise_distribution_option = 'default'
  phiinit = 0.01
/

&initialise_distribution_maxwellian
  width0 = 1.0
/

&time_trace_options
  nstep = 10
/

&time_step
  delt = 0.01
/

&numerical_algorithms
  explicit_algorithm = 'rk2'
  fully_explicit = .true.
/

&debug_flags
  print_extra_info_to_terminal = .false.
/

&dissipation_and_collisions_options
  hyper_dissipation = .true.
/
