! Test 4g: with exact_conservation, the Fokker-Planck collision operator must conserve the total parallel momentum and
! the total energy of ions and electrons to machine precision. Only collisions are switched on (no streaming, mirror,
! drifts, drive or potential), for ions and electrons with the real mass ratio at a large collision frequency
! (vnew_ref = 0.3), one mode with k_perp ~ 0 (aky = 1e-6) and without the finite-Larmor-radius terms, starting from
! a distribution with a parallel flow and a temperature perturbation. exact_conservation needs the operator without
! the mixed-derivative terms (include_mixed_derivative_terms = .false.) and the conservative vpa weights. The test
! runs this input on the equally spaced mu grid (the block-products algorithm) and on the Gauss-Laguerre mu grid
! (the test-particle-matrix algorithm), see test_4g_collisions_exact_conservation.py.

!===============================================================================
!                               Magnetic Geometry                               
!===============================================================================

&geometry_options
  geometry_option = 'miller'
/
&geometry_miller
  nzed_local = 128
  rhoc = 0.5
  shat = 0.796
  qinp = 1.4
  rmaj = 2.77778
  rgeo = 2.77778
  shift = 0.0
  kappa = 1.0
  kapprim = 0.0
  tri = 0.0
  triprim = 0.0
  betaprim = 0.0
  d2qdr2 = 0.0
  d2psidr2 = 0.0
  betadbprim = 0.0
/ 

!===============================================================================
!                                    Physics                                    
!===============================================================================

&scale_gyrokinetic_terms
  fphi = 0.0
/
&gyrokinetic_terms
  include_parallel_streaming = .false.
  include_mirror = .false.
  include_xdrift = .false.
  include_ydrift = .false.
  include_drive = .false.
  include_nonlinear = .false.
/

!===============================================================================
!                                Kinetic species                                
!===============================================================================

&species_options
  nspec = 2
/
&species_parameters_1
  dens = 1.0
  fprim = 1.0
  mass = 1.0
  temp = 1.0
  tprim = 3.0
  type = 'ion'
  z = 1.0
/
&species_parameters_2
  dens = 1.0
  fprim = 1.0
  mass = 0.0005446
  temp = 1.0
  tprim = 3.0
  type = 'electron'
  z = -1.0
/

!===============================================================================
!                       Discretized (kx,ky,z,mu,vpa) grid                       
!===============================================================================

&kxky_grid_option
  grid_option = 'range'
/
&kxky_grid_range
  naky = 1
  nakx = 1
  aky_min = 1.0e-6
  aky_max = 1.0e-6
/
&z_grid
  nzed = 12
/
&z_boundary_condition
  boundary_option = 'default'
/
&velocity_grids
  nmu = 8
  nvgrid = 12
  vpa_max = 3.0
  vperp_max = 3.0
  equally_spaced_mu_grid = .true.
  conservative_wgts_vpa = .true.
/
&dissipation_and_collisions_options
  include_collisions = .true.
  collision_model = 'fokker-planck'
  collisions_implicit = .true.
  vnew_ref = 0.3
/
&collisions_fokker_planck
  include_field_particle_part = .true.
  include_flr_terms = .false.
  include_mixed_derivative_terms = .false.
  exact_conservation = .true.
/

!===============================================================================
!                                  Diagnostics                                  
!===============================================================================

&diagnostics
  nsave = 100
  nwrite = 10 
  write_all_potential = .true.
/
&diagnostics_moments
  write_moments = .true.
/

!===============================================================================
!                              initialise potential                             
!===============================================================================

&initialise_distribution
  initialise_distribution_option = 'kpar'
  phiinit = 0.01
/
&initialise_distribution_kpar
  width0 = -1.0
  refac = 1.0
  imfac = 0.0
  den0 = 0.0
  upar0 = 1.0
  tpar0 = 1.0
  tperp0 = 0.5
/

&initialise_distribution_maxwellian
  width0 = 1.0
/

!===============================================================================
!                                    Numerics                                   
!===============================================================================

&time_trace_options
  nstep = 50
/

&time_step
  delt = 0.01
/

&numerical_algorithms
  explicit_algorithm = 'rk2'
  stream_implicit = .true.
  mirror_implicit = .true.
  drifts_implicit = .false.
/

&debug_flags 
  print_extra_info_to_terminal = .false. 
/



